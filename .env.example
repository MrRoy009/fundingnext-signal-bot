# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Credentials are optional: if left blank, the bot attaches to whatever account the
# MT5 terminal is already logged into (it still refuses anything that is not DEMO).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# REQUIRED: terminal64.exe of a separate MT5 install used only for the demo data account,
# never the terminal you trade the competition from. Example:
# MT5_PATH=D:\MT5-Data\terminal64.exe
MT5_PATH=
# true if that terminal runs in portable mode (keeps its accounts and data in its own folder)
MT5_PORTABLE=
# Login number of your competition account. The bot refuses to run if connected to it.
COMPETITION_LOGIN=
